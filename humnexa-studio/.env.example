## SUPABASE (Mumbai Region — ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

## GROQ AI (Primary LLM)
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.1-70b-versatile

## ANTHROPIC (Fallback 1)
ANTHROPIC_API_KEY=sk-ant-your_key
ANTHROPIC_MODEL=claude-sonnet-4-5

## OPENAI (Fallback 2)
OPENAI_API_KEY=sk-your_key
OPENAI_MODEL=gpt-4o-mini

## RESEND
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@humnexa.com

## RAZORPAY
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

## GITHUB (OAuth + repo operations)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_secret
GITHUB_TOKEN=ghp_your_personal_access_token

## VERCEL
VERCEL_TOKEN=your_vercel_access_token
VERCEL_TEAM_ID=team_your_team_id

## SENTRY
NEXT_PUBLIC_SENTRY_DSN=https://your@sentry.io/project

## APP CONFIG
NEXT_PUBLIC_APP_URL=https://studio.humnexa.com
NEXTAUTH_SECRET=your_32_char_random_string
NEXTAUTH_URL=https://studio.humnexa.com

## FEATURE FLAGS
ENABLE_VISUAL_EDIT=true
ENABLE_PLAN_MODE=true
ENABLE_HINDI_MODE=true
ENABLE_FLUTTER=false
